%% ============================================================================
%% COLOR MANIPULATION
%% ============================================================================

% Lighten a color
% #1 = color name
% #2 = percentage (0-100)
\newcommand{\tbkLighten}[2]{%
  tbk@color@#1!#2!white%
}

% Darken a color
% #1 = color name
% #2 = percentage (0-100)
\newcommand{\tbkDarken}[2]{%
  tbk@color@#1!#2!black%
}

% Color with opacity
% #1 = color name
% #2 = opacity (0-100)
\newcommand{\tbkColorOpacity}[2]{%
  tbk@color@#1!#2%
}

