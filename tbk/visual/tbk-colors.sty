%% ============================================================================
%% COLOR ACCESSOR COMMAND
%% ============================================================================

% Get a color by name
% #1 = color name (e.g., primary, danger, text)
\newcommand{\tbkColor}[1]{tbk@color@#1}

% Use color in text
% #1 = color name
% #2 = text
\newcommand{\tbkTextColor}[2]{%
  \textcolor{tbk@color@#1}{#2}%
}

%% ============================================================================
%% COLOR SCHEME DEFINITION
%% ============================================================================

% Define a new color scheme
% #1 = scheme name
% #2 = key-value pairs of colors
\newcommand{\tbkDefineColorScheme}[2]{%
  \pgfkeys{
    /tbk/colorscheme/#1/.cd,
    #2
  }%
  % Mark scheme as defined
  \expandafter\def\csname tbk@colorscheme@#1@defined\endcsname{1}%
}

% Internal: Process color scheme keys
\pgfkeys{
  /tbk/colorscheme/.is family,
  /tbk/colorscheme/.unknown/.code={%
    % Parse RGB values and define color
    \tbk@parseanddefinecolor{\pgfkeyscurrentname}{#1}%
  },
}

% Parse RGB tuple and define color
% #1 = color name
% #2 = RGB values as {R, G, B}
\newcommand{\tbk@parseanddefinecolor}[2]{%
  \tbk@extractrgb{#2}%
  \definecolor{tbk@color@#1}{RGB}{\tbk@rgb@r, \tbk@rgb@g, \tbk@rgb@b}%
}

% Extract RGB values from {R, G, B} format
\ExplSyntaxOn
\cs_new:Npn \tbk@extractrgb #1 {
  \seq_set_split:Nnn \l_tmpa_seq {,} {#1}
  \seq_pop_left:NN \l_tmpa_seq \l_tmpa_tl
  \tl_gset:Nx \tbk@rgb@r {\tl_trim_spaces:V \l_tmpa_tl}
  \seq_pop_left:NN \l_tmpa_seq \l_tmpa_tl
  \tl_gset:Nx \tbk@rgb@g {\tl_trim_spaces:V \l_tmpa_tl}
  \seq_pop_left:NN \l_tmpa_seq \l_tmpa_tl
  \tl_gset:Nx \tbk@rgb@b {\tl_trim_spaces:V \l_tmpa_tl}
}
\ExplSyntaxOff

\def\tbk@rgb@r{0}
\def\tbk@rgb@g{0}
\def\tbk@rgb@b{0}

%% ============================================================================
%% USE COLOR SCHEME
%% ============================================================================

% Switch to a different color scheme
% #1 = scheme name
\newcommand{\tbkUseColorScheme}[1]{%
  \ifcsdef{tbk@colorscheme@#1@defined}{%
    \def\tbk@currentcolorscheme{#1}%
    % The colors are already defined, nothing more needed
  }{%
    \PackageError{tbk-colors}{Color scheme '#1' is not defined}%
      {Use \string\tbkDefineColorScheme to define it first.}%
  }%
}

