%% ============================================================================
%% MAIN ICON COMMAND
%% ============================================================================

% Get icon by name
% #1 = optional settings
% #2 = icon name
\NewDocumentCommand{\tbkIcon}{O{}m}{%
  \pgfkeys{/tbk/icon/.cd, #1}%
  % Check if it's a predefined icon
  \ifcsdef{tbk@icondef@#2}{%
    % Use predefined icon
    \ifdefempty{\tbk@icon@color}{%
      {\fontsize{\tbk@icon@size}{\tbk@icon@size}\selectfont\csname tbk@icondef@#2\endcsname}%
    }{%
      {\fontsize{\tbk@icon@size}{\tbk@icon@size}\selectfont\textcolor{\tbk@icon@color}{\csname tbk@icondef@#2\endcsname}}%
    }%
  }{%
    % Check if it's a custom icon path
    \ifdefempty{\tbk@icon@path}{%
      % Icon not found - show warning
      \PackageWarning{tbk-icons}{Icon '#2' not found}%
      {\fontsize{\tbk@icon@size}{\tbk@icon@size}\selectfont\faQuestion}%
    }{%
      % Use custom image
      \includegraphics[height=\tbk@icon@size]{\tbk@icon@path}%
    }%
  }%
  % Reset
  \def\tbk@icon@size{1em}%
  \def\tbk@icon@color{}%
  \def\tbk@icon@path{}%
}

%% ============================================================================
%% DEFINE CUSTOM ICONS
%% ============================================================================

% Define a new icon
% #1 = icon name
% #2 = icon command or image path
\NewDocumentCommand{\tbkDefineIcon}{mm}{%
  \expandafter\newcommand\csname tbk@icondef@#1\endcsname{%
    \IfFileExists{#2}{%
      \includegraphics[height=1em]{#2}%
    }{%
      #2%
    }%
  }%
}

%% ============================================================================
%% BUTTON COMMAND
%% ============================================================================

\pgfkeys{
  /tbk/button/.is family,
  /tbk/button/.cd,
  % Style
  style/.is choice,
  style/filled/.code={\def\tbk@button@style{filled}},
  style/outlined/.code={\def\tbk@button@style{outlined}},
  style/text/.code={\def\tbk@button@style{text}},
  style/.default=filled,
  % Icon
  icon/.store in=\tbk@button@icon,
  icon/.default={},
  % Color
  color/.store in=\tbk@button@color,
  color/.default={black},
  % Background
  background/.store in=\tbk@button@bg,
  background/.default={gray!20},
}

\def\tbk@button@style{filled}
\def\tbk@button@icon{}
\def\tbk@button@color{black}
\def\tbk@button@bg{gray!20}

% Button with text
% #1 = options
% #2 = text
\NewDocumentCommand{\tbkButton}{O{}m}{%
  \pgfkeys{/tbk/button/.cd, #1}%
  \ifdefstring{\tbk@button@style}{filled}{%
    \tikz[baseline=(text.base)]{%
      \node[%
        fill=\tbk@button@bg,
        rounded corners=3pt,
        inner sep=4pt,
        font=\small\sffamily,
      ] (text) {%
        \ifdefempty{\tbk@button@icon}{}{\tbkIcon{\tbk@button@icon}~}%
        #2%
      };
    }%
  }{}%
  \ifdefstring{\tbk@button@style}{outlined}{%
    \tikz[baseline=(text.base)]{%
      \node[%
        draw=\tbk@button@color,
        rounded corners=3pt,
        inner sep=4pt,
        font=\small\sffamily,
      ] (text) {%
        \ifdefempty{\tbk@button@icon}{}{\tbkIcon{\tbk@button@icon}~}%
        #2%
      };
    }%
  }{}%
  \ifdefstring{\tbk@button@style}{text}{%
    {\small\sffamily
      \ifdefempty{\tbk@button@icon}{}{\tbkIcon{\tbk@button@icon}~}%
      #2%
    }%
  }{}%
  % Reset
  \def\tbk@button@style{filled}%
  \def\tbk@button@icon{}%
  \def\tbk@button@color{black}%
  \def\tbk@button@bg{gray!20}%
}

%% ============================================================================
%% KEYBOARD KEY
%% ============================================================================

% Keyboard key style
% #1 = key text
\NewDocumentCommand{\tbkKey}{m}{%
  \tikz[baseline=(key.base)]{%
    \node[%
      draw=gray!60,
      fill=gray!10,
      rounded corners=2pt,
      inner sep=3pt,
      font=\small\ttfamily,
      minimum height=1.5em,
    ] (key) {#1};
  }%
}

% Common key shortcuts
\newcommand{\tbkKeyCtrl}{\tbkKey{Ctrl}}
\newcommand{\tbkKeyAlt}{\tbkKey{Alt}}
\newcommand{\tbkKeyShift}{\tbkKey{Shift}}
\newcommand{\tbkKeyEnter}{\tbkKey{Enter}}
\newcommand{\tbkKeyEsc}{\tbkKey{Esc}}
\newcommand{\tbkKeyTab}{\tbkKey{Tab}}
\newcommand{\tbkKeySpace}{\tbkKey{Space}}
\newcommand{\tbkKeyBackspace}{\tbkKey{Backspace}}
\newcommand{\tbkKeyDelete}{\tbkKey{Del}}

% Keyboard shortcut
% #1 = keys separated by +
\NewDocumentCommand{\tbkShortcut}{m}{%
  \tbk@parseshortcut#1+\@nil
}

\def\tbk@parseshortcut#1+#2\@nil{%
  \tbkKey{#1}%
  \ifx\relax#2\relax\else
    ~+~\tbk@parseshortcut#2\@nil
  \fi
}

