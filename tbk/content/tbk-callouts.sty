  \definecolor{tbk@callout@danger@border}{RGB}{200, 0, 0}
  \definecolor{tbk@callout@danger@title}{RGB}{150, 0, 0}
  % Warning
  \definecolor{tbk@callout@warning@bg}{RGB}{255, 250, 230}
  \definecolor{tbk@callout@warning@border}{RGB}{200, 150, 0}
  \definecolor{tbk@callout@warning@title}{RGB}{150, 100, 0}
  % Notice
  \definecolor{tbk@callout@notice@bg}{RGB}{230, 240, 255}
  \definecolor{tbk@callout@notice@border}{RGB}{0, 100, 180}
  \definecolor{tbk@callout@notice@title}{RGB}{0, 70, 140}
  % Caution
  \definecolor{tbk@callout@caution@bg}{RGB}{255, 245, 230}
  \definecolor{tbk@callout@caution@border}{RGB}{255, 140, 0}
  \definecolor{tbk@callout@caution@title}{RGB}{200, 100, 0}
  % Info
  \definecolor{tbk@callout@info@bg}{RGB}{235, 245, 255}
  \definecolor{tbk@callout@info@border}{RGB}{0, 120, 180}
